# Google Maps Embed API key used by the Location section on /experience/:id.
# Create it in Google Cloud, enable "Maps Embed API", and restrict the key to
# the HTTP referrers that serve this site (e.g. https://xiashuidaolaoshuren.github.io/*).
#
# Local development: copy this file to `.env.local` (gitignored).
# GitHub Pages: add a repository Actions secret with the same name so the
# deploy workflow can inject it at build time.
VITE_GOOGLE_MAPS_API_KEY=
